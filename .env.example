# Supabase Configuration
# These values are PUBLIC and safe to expose in the browser
# Get these from your Supabase project settings: https://app.supabase.com

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Storage Configuration (Optional - defaults are in src/config/storage.ts)
# VITE_MAX_UPLOAD_SIZE=10485760
# VITE_MAX_IMAGE_WIDTH=1920
# VITE_MAX_IMAGE_HEIGHT=1920
# VITE_WEBP_QUALITY=80

# IMPORTANT: Never commit .env files with real values
# Never expose SUPABASE_SERVICE_ROLE_KEY in the frontend
